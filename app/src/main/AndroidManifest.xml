<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Material3.Dark.NoActionBar">

        <!--
            The print service itself. This is the component the system Print Spooler
            discovers and lists as a destination, alongside "Save as PDF" and any
            other installed print services (PrinterShare, HP/Canon/Epson plugins, etc).
        -->
        <service
            android:name=".TwoUpPrintService"
            android:exported="true"
            android:stopWithTask="false"
            android:permission="android.permission.BIND_PRINT_SERVICE"
            android:settingsActivity=".MainActivity"
            android:addPrintersActivity=".MainActivity"
            android:label="@string/print_service_label">
            <intent-filter>
                <action android:name="android.printservice.PrintService" />
            </intent-filter>
            <meta-data
                android:name="android.printservice"
                android:resource="@xml/printservice" />
        </service>

        <!-- Optional: an add-printers activity, not required since we always expose one
             fixed virtual printer, but the framework wants a settings entry point to exist
             for the "Add printer" flow to be well-behaved. We reuse the main activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.printservice.ACTION_ADD_PRINTERS" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SaveDestinationActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.twoupprint.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
