<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141218"
    android:orientation="vertical">

    <!-- Material 3 App Bar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#141218"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="N-Up Print"
            android:textColor="#E6E0E9"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Layout Printers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:text="VIRTUAL PRINTER LAYOUTS"
                    android:textColor="#D0BCFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddLayout"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:textSize="11sp"
                    android:text="Add Layout"
                    app:icon="@android:drawable/ic_input_add" />
            </LinearLayout>

            <!-- Container for Spacious Layout Cards -->
            <LinearLayout
                android:id="@+id/layoutCardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Section 2: Text Contrast & Enhancement -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="TEXT &amp; LINK ENHANCEMENTS"
                android:textColor="#D0BCFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#211F26"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#49454F"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Enable high contrast text"
                                android:textColor="#E6E0E9"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Boosts faint text to solid black while preserving images"
                                android:textColor="#CAC4D0"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchTextContrast"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="#36343B" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Make URLs and links clickable"
                                android:textColor="#E6E0E9"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Preserves hyperlinks and detects URLs in text"
                                android:textColor="#CAC4D0"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchEnableLinks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Page & Slot Margins -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="PAGE &amp; SLOT MARGINS"
                android:textColor="#D0BCFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#211F26"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#49454F"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <!-- Box-Model Margin Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <!-- TOP SIDE SELECTOR -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:text="TOP:"
                                android:textColor="#D0BCFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/toggleGroupMarginTop"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:singleSelection="true">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnTop0"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="44dp"
                                    android:layout_height="28dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="0"
                                    android:textSize="10sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnTop3"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="44dp"
                                    android:layout_height="28dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="3mm"
                                    android:textSize="10sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnTop6"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="44dp"
                                    android:layout_height="28dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="6mm"
                                    android:textSize="10sp" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>
                        </LinearLayout>

                        <!-- MIDDLE ROW: LEFT SELECTOR + RECTANGLE PREVIEW + RIGHT SELECTOR -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <!-- LEFT SIDE SELECTOR -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="2dp"
                                    android:text="LEFT"
                                    android:textColor="#D0BCFF"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButtonToggleGroup
                                    android:id="@+id/toggleGroupMarginLeft"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:singleSelection="true">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnLeft0"
                                        style="?attr/materialButtonOutlinedStyle"
                                        android:layout_width="38dp"
                                        android:layout_height="28dp"
                                        android:insetTop="0dp"
                                        android:insetBottom="0dp"
                                        android:padding="0dp"
                                        android:text="0"
                                        android:textSize="10sp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnLeft3"
                                        style="?attr/materialButtonOutlinedStyle"
                                        android:layout_width="38dp"
                                        android:layout_height="28dp"
                                        android:insetTop="0dp"
                                        android:insetBottom="0dp"
                                        android:padding="0dp"
                                        android:text="3"
                                        android:textSize="10sp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnLeft6"
                                        style="?attr/materialButtonOutlinedStyle"
                                        android:layout_width="38dp"
                                        android:layout_height="28dp"
                                        android:insetTop="0dp"
                                        android:insetBottom="0dp"
                                        android:padding="0dp"
                                        android:text="6"
                                        android:textSize="10sp" />
                                </com.google.android.material.button.MaterialButtonToggleGroup>
                            </LinearLayout>

                            <!-- CENTRAL PREVIEW RECTANGLE -->
                            <com.example.twoupprint.MarginPreviewView
                                android:id="@+id/marginPreviewView"
                                android:layout_width="100dp"
                                android:layout_height="65dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="10dp" />

                            <!-- RIGHT SIDE SELECTOR -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="2dp"
                                    android:text="RIGHT"
                                    android:textColor="#D0BCFF"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButtonToggleGroup
                                    android:id="@+id/toggleGroupMarginRight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:singleSelection="true">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnRight0"
                                        style="?attr/materialButtonOutlinedStyle"
                                        android:layout_width="38dp"
                                        android:layout_height="28dp"
                                        android:insetTop="0dp"
                                        android:insetBottom="0dp"
                                        android:padding="0dp"
                                        android:text="0"
                                        android:textSize="10sp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnRight3"
                                        style="?attr/materialButtonOutlinedStyle"
                                        android:layout_width="38dp"
                                        android:layout_height="28dp"
                                        android:insetTop="0dp"
                                        android:insetBottom="0dp"
                                        android:padding="0dp"
                                        android:text="3"
                                        android:textSize="10sp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnRight6"
                                        style="?attr/materialButtonOutlinedStyle"
                                        android:layout_width="38dp"
                                        android:layout_height="28dp"
                                        android:insetTop="0dp"
                                        android:insetBottom="0dp"
                                        android:padding="0dp"
                                        android:text="6"
                                        android:textSize="10sp" />
                                </com.google.android.material.button.MaterialButtonToggleGroup>
                            </LinearLayout>

                        </LinearLayout>

                        <!-- BOTTOM SIDE SELECTOR -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:text="BOTTOM:"
                                android:textColor="#D0BCFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/toggleGroupMarginBottom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:singleSelection="true">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnBottom0"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="44dp"
                                    android:layout_height="28dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="0"
                                    android:textSize="10sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnBottom3"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="44dp"
                                    android:layout_height="28dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="3mm"
                                    android:textSize="10sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnBottom6"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="44dp"
                                    android:layout_height="28dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:padding="0dp"
                                    android:text="6mm"
                                    android:textSize="10sp" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>
                        </LinearLayout>

                        <!-- QUICK PRESET SHORTCUTS -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:text="Presets:"
                                android:textColor="#CAC4D0"
                                android:textSize="11sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPresetAll0"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:layout_marginEnd="4dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingLeft="6dp"
                                android:paddingRight="6dp"
                                android:text="All 0"
                                android:textSize="10sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPresetAll3"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:layout_marginEnd="4dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingLeft="6dp"
                                android:paddingRight="6dp"
                                android:text="All 3 mm"
                                android:textSize="10sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPresetHeaderSafe"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingLeft="6dp"
                                android:paddingRight="6dp"
                                android:text="Top 6 mm"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/marginDescriptionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Top: 0 mm • Bottom: 0 mm • Left: 0 mm • Right: 0 mm"
                            android:textColor="#D0BCFF"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="#36343B" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Auto-crop slide letterbox borders"
                                android:textColor="#E6E0E9"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Trims blank letterboxes so slides fill N-up slots"
                                android:textColor="#CAC4D0"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAutoCrop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Output Destination -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="OUTPUT DESTINATION"
                android:textColor="#D0BCFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#211F26"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#49454F"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save Folder"
                        android:textColor="#E6E0E9"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pathText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="#2B2930"
                        android:ellipsize="middle"
                        android:padding="8dp"
                        android:singleLine="true"
                        android:text="Downloads/TwoUpPrint/ (default)"
                        android:textColor="#D0BCFF"
                        android:textSize="12sp"
                        android:typeface="monospace" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetLocation"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingVertical="0dp"
                            android:textSize="12sp"
                            android:text="Select Folder"
                            app:icon="@android:drawable/ic_menu_upload" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResetLocation"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingVertical="0dp"
                            android:textSize="12sp"
                            android:text="Reset to Default" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="#49454F" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Prompt location per print"
                                android:textColor="#E6E0E9"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Show notification to choose folder per document"
                                android:textColor="#CAC4D0"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/promptSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: System & Reliability -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="SYSTEM &amp; RELIABILITY"
                android:textColor="#D0BCFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#211F26"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#49454F"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Battery Card Item -->
                    <LinearLayout
                        android:id="@+id/batteryCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/batteryTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Battery Optimization"
                                android:textColor="#E6E0E9"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/batterySub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Checking background service status..."
                                android:textColor="#CAC4D0"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBatteryAction"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="10dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="0dp"
                            android:textSize="11sp"
                            android:text="Configure" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#36343B" />

                    <!-- System Print Settings Item -->
                    <LinearLayout
                        android:id="@+id/btnOpenSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="System Print Settings"
                            android:textColor="#E6E0E9"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_preferences"
                            app:tint="#CAC4D0" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#36343B" />

                    <!-- Clear Old / Phantom Printers Item -->
                    <LinearLayout
                        android:id="@+id/btnClearOldPrinters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Clear Old / Phantom Printers"
                            android:textColor="#E6E0E9"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_delete"
                            app:tint="#CAC4D0" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#36343B" />

                    <!-- Troubleshoot Item -->
                    <LinearLayout
                        android:id="@+id/btnTroubleshoot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fix Stuck Print Job"
                            android:textColor="#E6E0E9"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_help"
                            app:tint="#CAC4D0" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
